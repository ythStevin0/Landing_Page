# ─── Server ───────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────
# Ganti dengan connection string dari MongoDB Atlas atau lokal
MONGO_URI=mongodb://localhost:27017/bangun-griya-nusantara

# ─── JWT ──────────────────────────────────────
JWT_SECRET=ganti_dengan_secret_yang_kuat_dan_panjang
JWT_EXPIRES_IN=7d

# ─── Admin Default (seed pertama kali) ────────
ADMIN_EMAIL=admin@bangungriya.com
ADMIN_PASSWORD=Admin@12345

# ─── CORS ─────────────────────────────────────
# URL frontend yang diizinkan akses API
CLIENT_URL=http://localhost:5173
